# =============================================================================
# Droidspaces Full Capabilities Kernel Fragment for Google Pixel 5 (Redbull)
# Base target: crDroid android_kernel_google_redbull (Linux 4.19)
# =============================================================================

# 1. User Namespaces (Required for rootless/unprivileged Docker, Podman, browser sandboxing)
CONFIG_USER_NS=y

# 2. CFS Bandwidth Cgroup (Required for container CPU quota enforcement: --cpus)
CONFIG_CFS_BANDWIDTH=y
CONFIG_FAIR_GROUP_SCHED=y

# 3. Macvlan & Macvtap (Required for direct physical LAN attachment: --net=macvlan)
CONFIG_MACVLAN=y
CONFIG_MACVTAP=y

# 4. IPv6 NAT / NAT66 (Required for full IPv6 internet in --net=nat mode)
CONFIG_IP6_NF_IPTABLES=y
CONFIG_IP6_NF_FILTER=y
CONFIG_IP6_NF_MANGLE=y
CONFIG_IP6_NF_NAT=y
CONFIG_IP6_NF_TARGET_MASQUERADE=y

# 5. Core IPC & POSIX MQueue
CONFIG_SYSVIPC=y
CONFIG_POSIX_MQUEUE=y
CONFIG_SYSVIPC_SYSCTL=y

# 6. OverlayFS Support
CONFIG_OVERLAY_FS=y

# 7. Bridge & Netfilter Essentials for Container L2/L3 Routing
CONFIG_BRIDGE=y
CONFIG_BRIDGE_NETFILTER=y
CONFIG_NETFILTER_ADVANCED=y
CONFIG_NETFILTER_XT_TARGET_CHECKSUM=y
CONFIG_NETFILTER_XT_MATCH_ADDRTYPE=y
CONFIG_NETFILTER_XT_MATCH_CONNTRACK=y
CONFIG_NETFILTER_XT_MATCH_IPVS=y
CONFIG_IP_SET=y
CONFIG_IP_SET_HASH_IP=y
CONFIG_IP_SET_HASH_NET=y

# 8. Device Filesystem Compatibility
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y

# 9. Build Performance & Memory Optimization
# ThinLTO significantly reduces RAM consumption during final vmlinux link (prevents GitHub Actions OOM)
CONFIG_THINLTO=y
